# ══════════════════════════════════════════════════════
# SISTEMA DEL ABSOLUTO — Variables de Entorno
# ══════════════════════════════════════════════════════

# Discord Bot Token (desde Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID del bot (desde Discord Developer Portal)
CLIENT_ID=your_discord_client_id_here

# ID del servidor de Discord del Dominio Absoluto
GUILD_ID=your_guild_id_here

# ID del dueño del bot (tu ID de Discord)
OWNER_ID=your_discord_id_here

# Puerto para el servidor web (Railway lo asigna automáticamente)
PORT=3000
